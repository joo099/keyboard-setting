{
  "title": "Developer HHKB Style Layer Ultimate Fixed",
  "rules": [
    {
      "description": "Caps Lock to Hyper/Fn Layer (Fixed Safe Block Mode)",
      "manipulators": [
        {
          "type": "basic",
          "from": {"key_code": "caps_lock", "modifiers": {"optional": ["any"]}},
          "to": [{"set_variable": {"name": "caps_lock_held", "value": 1}}],
          "to_after_key_up": [{"set_variable": {"name": "caps_lock_held", "value": 0}}]
        },
        {
          "type": "basic",
          "from": {"key_code": "grave_accent_and_tilde", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"key_code": "escape"}]
        },
        {
          "type": "basic",
          "from": {"key_code": "1", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"key_code": "f1"}]
        },
        {
          "type": "basic",
          "from": {"key_code": "2", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"key_code": "f2"}]
        },
        {
          "type": "basic",
          "from": {"key_code": "3", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"key_code": "f3"}]
        },
        {
          "type": "basic",
          "from": {"key_code": "4", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"key_code": "f4"}]
        },
        {
          "type": "basic",
          "from": {"key_code": "5", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"key_code": "f5"}]
        },
        {
          "type": "basic",
          "from": {"key_code": "6", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"key_code": "f6"}]
        },
        {
          "type": "basic",
          "from": {"key_code": "7", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"key_code": "f7"}]
        },
        {
          "type": "basic",
          "from": {"key_code": "8", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"key_code": "f8"}]
        },
        {
          "type": "basic",
          "from": {"key_code": "9", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"key_code": "f9"}]
        },
        {
          "type": "basic",
          "from": {"key_code": "0", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"key_code": "f10"}]
        },
        {
          "type": "basic",
          "from": {"key_code": "hyphen", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"key_code": "f11"}]
        },
        {
          "type": "basic",
          "from": {"key_code": "equal_sign", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"key_code": "f12"}]
        },
        {
          "type": "basic",
          "from": {"key_code": "w", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"mouse_key": {"y": -1500}}],
          "to_if_held_down": [{"mouse_key": {"y": -2500}}],
          "parameters": {"basic.to_if_held_down_threshold_milliseconds": 500}
        },
        {
          "type": "basic",
          "from": {"key_code": "a", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"mouse_key": {"x": -1500}}],
          "to_if_held_down": [{"mouse_key": {"x": -2500}}],
          "parameters": {"basic.to_if_held_down_threshold_milliseconds": 500}
        },
        {
          "type": "basic",
          "from": {"key_code": "s", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"mouse_key": {"y": 1500}}],
          "to_if_held_down": [{"mouse_key": {"y": 2500}}],
          "parameters": {"basic.to_if_held_down_threshold_milliseconds": 500}
        },
        {
          "type": "basic",
          "from": {"key_code": "d", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"mouse_key": {"x": 1500}}],
          "to_if_held_down": [{"mouse_key": {"x": 2500}}],
          "parameters": {"basic.to_if_held_down_threshold_milliseconds": 500}
        },
        {
          "type": "basic",
          "from": {"key_code": "spacebar", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"pointing_button": "button1"}]
        },
        {
          "type": "basic",
          "from": {"key_code": "q", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"pointing_button": "button2"}]
        },
        {
          "type": "basic",
          "from": {"key_code": "f", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"key_code": "f", "modifiers": ["apple_vendor_top_case_key_code_fn"]}]
        },
        {
          "type": "basic",
          "from": {"key_code": "u", "modifiers": {"mandatory": ["left_control"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"key_code": "page_up"}]
        },
        {
          "type": "basic",
          "from": {"key_code": "o", "modifiers": {"mandatory": ["left_control"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"key_code": "page_down"}]
        },
        {
          "type": "basic",
          "from": {"key_code": "u", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"mouse_key": {"vertical_wheel": -32}}],
          "to_if_held_down": [{"mouse_key": {"vertical_wheel": -64}}],
          "parameters": {"basic.to_if_held_down_threshold_milliseconds": 500}
        },
        {
          "type": "basic",
          "from": {"key_code": "o", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"mouse_key": {"vertical_wheel": 32}}],
          "to_if_held_down": [{"mouse_key": {"vertical_wheel": 64}}],
          "parameters": {"basic.to_if_held_down_threshold_milliseconds": 500}
        },
        {
          "type": "basic",
          "from": {"key_code": "j", "modifiers": {"mandatory": ["left_control"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"key_code": "left_arrow", "modifiers": ["apple_vendor_top_case_key_code_fn", "left_control"]}]
        },
        {
          "type": "basic",
          "from": {"key_code": "l", "modifiers": {"mandatory": ["left_control"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"key_code": "right_arrow", "modifiers": ["apple_vendor_top_case_key_code_fn", "left_control"]}]
        },
        {
          "type": "basic",
          "from": {"key_code": "i", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"key_code": "up_arrow"}]
        },
        {
          "type": "basic",
          "from": {"key_code": "j", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"key_code": "left_arrow"}]
        },
        {
          "type": "basic",
          "from": {"key_code": "k", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"key_code": "down_arrow"}]
        },
        {
          "type": "basic",
          "from": {"key_code": "l", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"key_code": "right_arrow"}]
        },
        {
          "type": "basic",
          "from": {"key_code": "h", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"key_code": "left_arrow", "modifiers": ["left_command"]}]
        },
        {
          "type": "basic",
          "from": {"key_code": "n", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"key_code": "right_arrow", "modifiers": ["left_command"]}]
        },
        {
          "type": "basic",
          "from": {"key_code": "delete_or_backspace", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"key_code": "delete_or_backspace", "modifiers": ["left_option"]}]
        },
        {
          "type": "basic",
          "from": {"key_code": "p", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"key_code": "mission_control"}]
        },
        {
          "type": "basic",
          "from": {"key_code": "open_bracket", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"key_code": "left_arrow", "modifiers": ["left_control"]}]
        },
        {
          "type": "basic",
          "from": {"key_code": "close_bracket", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"key_code": "right_arrow", "modifiers": ["left_control"]}]
        },
        {
          "type": "basic",
          "from": {"key_code": "c", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"key_code": "c", "modifiers": ["left_control"]}]
        },
        {
          "type": "basic",
          "from": {"key_code": "left_shift", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"key_code": "left_shift"}],
          "to_if_held_down": [{"mouse_key": {"speed_multiplier": 2.7}}],
          "parameters": {"basic.to_if_held_down_threshold_milliseconds": 20}
        },
        {
          "type": "basic",
          "from": {"key_code": "right_shift", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"key_code": "right_shift"}],
          "to_if_held_down": [{"mouse_key": {"speed_multiplier": 2.7}}],
          "parameters": {"basic.to_if_held_down_threshold_milliseconds": 20}
        },
        {
          "type": "basic",
          "from": {"key_code": "left_control", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"key_code": "left_control"}]
        },
        {
          "type": "basic",
          "from": {"key_code": "right_control", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"key_code": "right_control"}]
        },
        {
          "type": "basic",
          "from": {"key_code": "left_option", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"key_code": "left_option"}]
        },
        {
          "type": "basic",
          "from": {"key_code": "right_option", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"key_code": "right_option"}]
        },
        {
          "type": "basic",
          "from": {"key_code": "left_command", "modifiers": {"optional": ["any"]}},
          "conditions": [{"type": "variable_if", "name": "caps_lock_held", "value": 1}],
          "to": [{"key_code": "left_command"}]
